<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <DebugType>embedded</DebugType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/ArachisH/Flazzy</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <Title>Flazzy</Title>
        <PackageId>Hypo.Flazzy</PackageId>
        <Authors>ArachisH</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright (c) ArachisH 2026</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/ArachisH/Flazzy</PackageProjectUrl>
        <Description>A .NET library for reading, writing, and analyzing SWF files with ABC/AVM2, AS3 decompilation, and deobfuscation support.</Description>
        <PackageTags>swf;flash;shockwave-flash;as3;actionscript;actionscript3;abc;avm2;decompiler;deobfuscation;bytecode;parser;assembler;disassembler;reverse-engineering</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>